<linker>
    <!--
        PromptUGUI 通过反射发现 Control 子类、[UIAttr] 属性 setter 和 [Bind] 字段
        (ControlRegistry / ControlMeta)，IL2CPP 的静态分析器看不见这条调用链，
        默认 Managed Stripping Level=Minimal 以上就会把属性 setter 或元数据裁掉,
        症状是 build 后 color="#XXX"、sprite="..." 等属性静默失效。
        整个 Runtime assembly preserve 住，开箱即用。
        用户自定义 Control (在自己的 asmdef) 需要自行 preserve 或加 [Preserve]。
    -->
    <assembly fullname="PromptUGUI.Runtime" preserve="all"/>
</linker>
