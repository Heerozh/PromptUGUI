# PromptUGUI 默认控件皮肤 — 种田风像素（spec 2026-06-12-farm-pixel-skin §3）
# 奶油底 + 暖木描边 + 叶绿点缀。mask 必须纯白（stencil, 4af322b）。
ppu: 100
chars:
  K: #5A3A20
  W: #8B5E3C
  w: #C68B52
  H: #FFFBEA
  F: #FFF1D2
  f: #EFD9A8
  I: #E8CFA0
  P: #F0DBAE
  G: #58A63C
  g: #7CC850
  M: #FFFFFF
  Y: #E8C84B

# round/pressed 以 Image.Type.Tiled 渲染（ProceduralBuilders.ApplyDefaultSlicedSprite）：
# 四角 5px 固定，边条带 14px 周期平铺 —— 青苔/木纹/板缝随尺寸重复而非拉伸。
# 条带两端必须收回纯轮廓+底色，保证与四角及下一周期无缝衔接。
[pugui_9slice_round]
border: 5,5,5,5
tiled: true
grid:
  ..KKKKKGGKKKKGGGKKKKKK..
  .KwwwwwggwWWwgggwwwwwwK.
  KwYwwwwwGwwWwwGwwwwwwYwK
  KwwKKKKKKKKKKKKKKKKKKwwK
  KwwKHHHHHHHHHHHHHHHHKwwK
  KwwKHFFFFFFFFFFFFFFfKWWK
