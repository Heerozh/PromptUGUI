<?xml version="1.0" encoding="utf-8"?>
<PromptUGUI version="1">

  <!-- ScrollList 行模板 -->
  <Template name="OptionRow">
    <HStack height="32" spacing="8">
      <Text id="label" fontSize="20"/>
      <Frame width="0"/>
    </HStack>
  </Template>

  <!-- Carousel 卡片模板（bg tint / 标题由 C# BindItems 填） -->
  <Template name="DemoCard">
    <Frame>
      <Image id="bg" anchor="stretch" sprite="PromptUGUI/Defaults/pugui#pugui_9slice_round" type="tiled"/>
      <Text id="title" anchor="center" fontSize="22" raycastTarget="false"/>
    </Frame>
  </Template>

  <Screen name="CommonControls" reference="640x360" reference.portrait="360x640" scale-mode="pixel">
    <!-- 背景：天空 + 草地两层 -->
    <Image anchor="stretch" color="#BDE3EC"/>
    <Image anchor="bottom-stretch" height="56" color="#8FCF6A" raycastTarget="false"/>
    <SafeArea>

      <!-- 顶部固定：木牌标题 + 常驻新手引导按钮（Btn 不写 color，吃默认皮肤） -->
      <HStack anchor="top-stretch" height="44" padding="8" spacing="8">
        <Image sprite="PromptUGUI/Defaults/pugui#pugui_9slice_round" type="tiled" color="#E8B86B" width="220" height="30">
          <Text anchor="center" fontSize="18" raycastTarget="false">Common Controls Demo</Text>
        </Image>
        <Frame width="0"/>
        <Btn id="tutorialBtn" width="100" height="28" fontSize="16">新手引导</Btn>
      </HStack>

      <!-- TabBar 分页（bind= 切页；Tab 是 layout child，只写 width/height） -->
      <TabBar id="tabs" anchor="top-stretch" height="32" margin="44,8,0,8">
        <Tab id="tabForm"    width="84" text="表单输入" fontSize="15"
             selectedColor="#CDEBA8" bind="pageForm" isOn="true"/>
        <Tab id="tabDisplay" width="84" text="展示反馈" fontSize="15"
             selectedColor="#CDEBA8" bind="pageDisplay"/>
        <Tab id="tabList"    width="84" text="列表轮播" fontSize="15"
             selectedColor="#CDEBA8" bind="pageList"/>
        <Tab id="tabModal"   width="84" text="模态提示" fontSize="15"
             selectedColor="#CDEBA8" bind="pageModal"/>
      </TabBar>

      <!-- ① 表单输入（原 Settings 内容保留） -->
      <Frame id="pageForm" anchor="stretch" margin="84,8,8,8">
        <Image anchor="stretch" sprite="PromptUGUI/Defaults/pugui#pugui_9slice_round" type="tiled" raycastTarget="false"/>
        <VStack anchor="stretch" spacing="12" padding="8">
          <InputField id="username" placeholder="Username" width="240" height="30"/>
          <Toggle id="muteAudio">静音</Toggle>
          <Slider id="masterVol" min="0" max="1" value="0.8"/>
          <Dropdown id="quality"/>
        </VStack>
      </Frame>

      <!-- ② 展示反馈 -->
      <Frame id="pageDisplay" anchor="stretch" margin="84,8,8,8">
        <Image anchor="stretch" sprite="PromptUGUI/Defaults/pugui#pugui_9slice_round" type="tiled" raycastTarget="false"/>
        <VStack anchor="stretch" spacing="10" padding="8">
          <Progress id="progress" height="16" value="0.3" bgColor="#E8CFA0" fillColor="#58A63C"/>
          <HStack height="28" spacing="8">
            <Btn id="progMinus" width="64" height="28" fontSize="15">-10%</Btn>
            <Btn id="progPlus"  width="64" height="28" fontSize="15">+10%</Btn>
            <Frame width="0"/>
          </HStack>
          <!-- RawImage：纹理由 C# 生成后喂入 -->
          <RawImage id="gradient" height="40"/>
          <!-- Animation：点击按钮自身 pulse（VStack 内包 Animation 是文档认可的模式）
               + 状态可视化：<Show on="state-hover"> 草莓角标（SpriteSet farm: 引用示例） -->
          <Animation type="pulse" on="click" duration="0.3s">
            <Btn id="pulseBtn" width="120" height="30">
              <Text anchor="center" fontSize="15" raycastTarget="false">点我弹跳</Text>
              <Show on="state-hover">
                <Image anchor="top-right" size="12x12" sprite="farm:strawberry" raycastTarget="false"/>
              </Show>
            </Btn>
          </Animation>
          <!-- Markdown：宿主未装 Markdig 时自动降级纯文本 -->
          <Markdown id="md" height="stretch">**Markdown** 控件：支持 *斜体* / `代码` / [链接](https://example.com)</Markdown>
        </VStack>
      </Frame>

      <!-- ③ 列表轮播 -->
      <Frame id="pageList" anchor="stretch" margin="84,8,8,8">
        <Image anchor="stretch" sprite="PromptUGUI/Defaults/pugui#pugui_9slice_round" type="tiled" raycastTarget="false"/>
        <VStack anchor="stretch" spacing="10" padding="8">
          <!-- farm: SpriteSet 12 作物橱窗 -->
          <Grid columns="6" cellSize="32x32" spacing="4" height="72">
            <Image sprite="farm:carrot"/><Image sprite="farm:tomato"/><Image sprite="farm:wheat"/>
            <Image sprite="farm:apple"/><Image sprite="farm:corn"/><Image sprite="farm:pumpkin"/>
            <Image sprite="farm:strawberry"/><Image sprite="farm:eggplant"/><Image sprite="farm:sunflower"/>
            <Image sprite="farm:grape"/><Image sprite="farm:watermelon"/><Image sprite="farm:turnip"/>
          </Grid>
          <Carousel id="banner" height="90" itemTemplate="DemoCard"
                    interval="3" loop="true" transition="0.3"
                    dots="bottom-center" dotColor="#C8A878" dotSelectedColor="#5A3A20"/>
          <ScrollList id="list" width="stretch" height="stretch" itemTemplate="OptionRow"
                      spacing="4" padding="8"/>
        </VStack>
      </Frame>

      <!-- ④ 模态提示 -->
      <Frame id="pageModal" anchor="stretch" margin="84,8,8,8">
        <Image anchor="stretch" sprite="PromptUGUI/Defaults/pugui#pugui_9slice_round" type="tiled" raycastTarget="false"/>
        <VStack anchor="stretch" spacing="10" padding="8">
          <Btn id="msgBoxBtn"   height="30" fontSize="15">MessageBox</Btn>
          <Btn id="inputBoxBtn" height="30" fontSize="15">InputBox</Btn>
          <Btn id="mdBoxBtn"    height="30" fontSize="15">MarkdownBox</Btn>
          <Btn id="loadingBtn"  height="30" fontSize="15">Loading (2s)</Btn>
          <!-- 演示 color= tint 仍可用：默认皮肤上叠一层绿 tint -->
          <Btn id="toastBtn"    height="30" fontSize="15" color="#A8D88C">Toast</Btn>
        </VStack>
      </Frame>

    </SafeArea>
  </Screen>
</PromptUGUI>
